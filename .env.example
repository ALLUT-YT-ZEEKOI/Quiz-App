# Frontend settings. Copy to ".env.local" for local development.
# URL of the CohesionTech API (the backend folder). Leave empty to run the app
# without a server (data stays in this browser only).
VITE_API_URL=http://localhost:5000/api

# Optional: largest note file in MB (default 4 with a backend, matching Vercel's limit)
# VITE_MAX_NOTE_FILE_MB=4
