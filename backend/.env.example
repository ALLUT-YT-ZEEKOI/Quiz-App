# ---------------------------------------------------------------------------
# CohesionTech API settings. Copy this file to ".env" and fill in your values.
# Never commit .env (it contains your database password and secrets).
# ---------------------------------------------------------------------------

# Port the API listens on
PORT=5000

# MongoDB Atlas connection string (Atlas > Database > Connect > Drivers).
# Replace <db_password> with your database user's password.
MONGODB_URI=mongodb+srv://cohesion_app:<db_password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0

# Database name inside the cluster
MONGODB_DB=cohesiontech

# Long random secret used to sign login tokens (at least 32 characters).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# How long a login stays valid
JWT_EXPIRES_IN=30d

# Frontend URLs allowed to use this API (comma-separated, no trailing slash)
CLIENT_ORIGINS=http://localhost:3000

# Admin account (created on first start; change ADMIN_PASSWORD and restart to update it)
ADMIN_USERNAME=admin
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Admin

# Optional: largest note file in MB (default 4 on Vercel because of its 4.5 MB request limit, 25 elsewhere)
# MAX_NOTE_FILE_MB=4
